# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
SECRET_KEY=change-me-in-prod      # used for JWT signing; generate with: openssl rand -hex 32
CORS_ORIGINS=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://blackbox:blackbox@localhost:5432/blackbox
# For local SQLite (dev only):
# DATABASE_URL=sqlite:///./blackbox.db

# ─── Object Storage ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=local             # local | s3
STORAGE_LOCAL_PATH=./storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ─── Redis / Worker Queue ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Meta AI APIs ───────────────────────────────────────────────────────────────
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=                     # never commit a real key

# SAM 3.1
SAM_API_URL=https://api.meta.ai/v1/sam
SAM_API_KEY=

# Muse Voice Transcribe
MUSE_VOICE_API_URL=https://api.meta.ai/v1/muse/voice
MUSE_VOICE_API_KEY=

# Muse Spark
MUSE_SPARK_API_URL=https://api.meta.ai/v1/muse/spark
MUSE_SPARK_API_KEY=

# ─── External Data APIs (free) ──────────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OVERPASS_BASE_URL=https://overpass-api.de/api

# ─── Feature Flags ──────────────────────────────────────────────────────────────
ENABLE_SAM3D=false                # SAM 3D Objects integration; verify license first
ENABLE_PREVENTION_ATLAS=false     # requires consented multi-case data

# ─── Numerical Engine ───────────────────────────────────────────────────────────
ENGINE_DEFAULT_SEED=42            # fixed seed for reproducible counterfactuals
ENGINE_MAX_SAMPLES=1000           # posterior samples per model run

# ─── Upload Limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
MAX_CLIPS_PER_CASE=3
